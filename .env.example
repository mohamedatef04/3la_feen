# Copy this file to .env and fill in your own values.
# Note: .env is bundled as a Flutter asset, so anything here ships inside the app.
# Only put client-safe values here (no CI tokens or service-role keys).

ANDROID_CHANNEL_ID=high_importance_channel
ANDROID_CHANNEL_NAME=High Importance Notifications
NOTIFICATION_CHANNEL_DESCRIPTION=Used for trip and chat notifications

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
